# ==========================================
# 🔔 MAKO NOTIFICATION CONFIGURATION
# ==========================================
max-history=50
sort=-time

# Layout & Geometry
font=JetBrains Mono 10
width=320
height=110
margin=10
padding=12
border-size=2
border-radius=8

# Colors & Style
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#cba6f7
progress-color=over #89b4fa

# Position & Behavior
anchor=top-right
default-timeout=5000
ignore-timeout=1

# Category Overrides
[urgency=critical]
border-color=#f38ba8
default-timeout=0
